GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=
QURANAI_API_PORT=7990
ENABLE_HADITH_TOOLS=1
# Optional: override where corpus JSON and ChromaDB files are read/written (default: src/quranai/data)
# QURANAI_DATA_DIR=/path/to/corpora
# Optional: host directory baked into Docker images by docker-compose / deploy.sh (default: ./src/quranai/data)
# QURANAI_DATA_HOST_DIR=/path/to/corpora
